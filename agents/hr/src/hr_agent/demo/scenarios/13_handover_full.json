{
  "title": "인수인계: 초안 → 질문 답변 → 확정",
  "description": "교대로 결제 영역 담당 emp_01이 emp_02에게 넘긴다. 진행 중 3건은 자동으로 채워지고 결정·되돌림 기준·위험은 질문으로 돌아온다. 답을 모두 채우면 planning이 누락을 확인하고 확정한다.",
  "steps": [
    {
      "skill": "start_handover",
      "requester": "orchestrator",
      "input": {"owner_id": "emp_01", "successor_id": "emp_02", "reason": "shift"},
      "expect": {
        "status": "input-required",
        "output": {"completeness": 40, "gap_count": 3, "status": "input_required"},
        "output_has": ["handover_id", "items.0.item_id", "questions.0.question_id"]
      }
    },
    {
      "skill": "answer_handover_question",
      "requester": "dashboard-api",
      "input": {"question_id": "${step1.output.questions.0.question_id}", "answer": "재시도는 최대 2회로 확정했다"},
      "expect": {"status": "completed", "outcome": "answered", "output": {"completeness": 60}}
    },
    {
      "skill": "answer_handover_question",
      "requester": "dashboard-api",
      "input": {"question_id": "${step1.output.questions.1.question_id}", "answer": "오류율이 5%를 넘으면 직전 버전으로 되돌린다"},
      "expect": {"status": "completed", "outcome": "answered", "output": {"completeness": 80}}
    },
    {
      "skill": "answer_handover_question",
      "requester": "dashboard-api",
      "input": {"question_id": "${step1.output.questions.2.question_id}", "answer": "야간 배치와 겹치면 타임아웃이 늘 수 있다"},
      "expect": {"status": "completed", "output": {"completeness": 100, "status": "ready"}}
    },
    {
      "skill": "confirm_handover",
      "requester": "dashboard-api",
      "input": {"handover_id": "${step1.output.handover_id}"},
      "expect": {"status": "completed", "outcome": "confirmed", "output": {"status": "confirmed", "completeness": 100}}
    }
  ]
}
