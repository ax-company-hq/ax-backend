          "area:payment"
        ],
        "author": "planning"
      },
      "expect": {
        "status": "completed",
        "outcome": "card_created"
      }
    },
    {
      "skill": "record_case",
      "requester": "planning",
      "context_id": "ctx_dec_0002",
