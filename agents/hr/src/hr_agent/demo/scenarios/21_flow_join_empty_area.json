{
  "title": "입사: 담당 없는 영역을 채운다",
  "description": "inventory 영역은 담당이 없다. emp_10이 입사해 담당이 되면 공백이 사라지고 온보딩 계획이 만들어진다.",
  "steps": [
    {
      "skill": "get_roster",
      "requester": "orchestrator",
      "context_id": "ctx_ros_0001",
      "label": "처음엔 공백",
      "input": {
        "area": "inventory"
      },
      "expect": {
        "status": "completed",
        "output": {
          "gap_areas.0": "inventory"
        }
      }
    },
    {
      "skill": "request_assignment_change",
      "requester": "orchestrator",
      "context_id": "ctx_asg_0001",
      "label": "입사 요청",
      "input": {
        "change_kind": "join",
        "member_id": "emp_10",
        "area": "inventory"
      },
      "expect": {
        "status": "completed",
        "outcome": "requested",
        "output_has": [
          "onboarding_id",
          "access_list.0"
        ]
      }
    },
    {
      "skill": "confirm_reassignment",
      "requester": "orchestrator",
      "context_id": "ctx_asg_0001",
      "label": "입사 확정",
      "input": {
        "change_id": "${step2.output.change_id}",
        "successor_id": "emp_10"
      },
      "expect": {
        "status": "completed",
        "outcome": "confirmed"
      }
    },
    {
      "skill": "get_roster",
      "requester": "orchestrator",
      "context_id": "ctx_ros_0002",
      "label": "공백 해소",
      "input": {
        "area": "inventory"
      },
      "expect": {
        "status": "completed",
        "output": {
          "entries.0.member_id": "emp_10",
          "gap_areas": []
        }
      }
    }
  ]
}
