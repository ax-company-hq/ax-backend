{
  "title": "발령: 담당이 비지 않게 재배치",
  "description": "결제 영역 담당 emp_01을 발령한다. 후임 후보에는 같은 영역 예비 담당 emp_02가 먼저 나오고, 확정하면 담당 공백·중복 없이 emp_02가 담당이 된다. 인수인계도 함께 시작된다.",
  "steps": [
    {
      "skill": "request_assignment_change",
      "requester": "orchestrator",
      "input": {"change_kind": "transfer", "member_id": "emp_01", "area": "payment"},
      "expect": {
        "status": "completed",
        "outcome": "requested",
        "output_has": ["change_id", "handover_id", "checklist.0.title", "access_list.0", "successor_candidates.0"]
      }
    },
    {
      "skill": "confirm_reassignment",
      "requester": "dashboard-api",
      "input": {"change_id": "${step1.output.change_id}", "successor_id": "emp_02"},
      "expect": {"status": "completed", "outcome": "confirmed", "output": {"status": "confirmed", "gap_areas": [], "duplicate_areas": []}}
    },
    {
      "skill": "get_roster",
      "requester": "orchestrator",
      "input": {"area": "payment"},
      "expect": {"status": "completed", "output": {"entries.0.member_id": "emp_02", "gap_areas": []}}
    }
  ]
}
