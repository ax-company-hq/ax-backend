{
  "title": "퇴직한 사람은 후임이 될 수 없다",
  "description": "emp_01의 퇴직을 끝낸 뒤 그를 다른 영역의 후임으로 지정하면 거절된다.",
  "steps": [
    {
      "skill": "request_assignment_change",
      "requester": "orchestrator",
      "context_id": "ctx_asg_0001",
      "label": "퇴직 요청",
      "input": {
        "change_kind": "offboarding",
        "member_id": "emp_01",
        "area": "payment",
        "successor_id": "emp_02"
      },
      "expect": {
        "status": "completed",
        "outcome": "requested"
      }
    },
    {
      "skill": "confirm_reassignment",
      "requester": "orchestrator",
      "context_id": "ctx_asg_0001",
      "label": "일 넘기기",
      "input": {
        "change_id": "${step1.output.change_id}",
        "successor_id": "emp_02"
      },
      "expect": {
        "status": "completed",
        "outcome": "confirmed"
      }
    },
    {
      "skill": "confirm_offboarding",
      "requester": "orchestrator",
      "context_id": "ctx_asg_0001",
      "label": "보류",
      "input": {
        "change_id": "${step1.output.change_id}"
      },
      "expect": {
        "status": "input-required",
        "output": {
          "status": "held"
        },
        "output_has": [
          "hold_id"
        ]
      },
      "key": "ctx_demo:off"
    },
    {
      "action": "decide_hold",
      "label": "승인",
      "review_id": "${step3.output.hold_id}",
      "approved": true
    },
    {
      "skill": "confirm_offboarding",
      "requester": "orchestrator",
      "context_id": "ctx_asg_0001",
      "label": "퇴직 적용",
      "input": {
        "change_id": "${step1.output.change_id}"
      },
      "expect": {
        "status": "completed",
        "outcome": "confirmed"
      },
      "key": "ctx_demo:off"
    },
    {
      "skill": "request_assignment_change",
      "requester": "orchestrator",
      "context_id": "ctx_asg_0002",
      "label": "퇴직자를 후임으로 지정 → 거절",
      "input": {
        "change_kind": "transfer",
        "member_id": "emp_03",
        "area": "search",
        "successor_id": "emp_01"
      },
      "expect": {
        "status": "completed",
        "outcome": "UNKNOWN_MEMBER"
      }
    }
  ]
}
