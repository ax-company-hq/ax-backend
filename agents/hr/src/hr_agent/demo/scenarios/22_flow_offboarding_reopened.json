{
  "title": "퇴직: 보류가 거절돼도 다시 열어 끝낸다",
  "description": "퇴직 확정은 사람 승인이 필요하다. 첫 보류를 거절하면 퇴직만 취소되고 잠금이 풀리며, 같은 요청으로 다시 열면 새 보류가 생겨 승인하면 적용된다.",
  "steps": [
    {
      "skill": "request_assignment_change",
      "requester": "orchestrator",
      "context_id": "ctx_asg_0001",
      "label": "퇴직 요청",
      "input": {
        "change_kind": "offboarding",
        "member_id": "emp_06",
        "area": "support-desk",
        "successor_id": "emp_07"
      },
      "expect": {
        "status": "completed",
        "outcome": "requested"
      }
    },
    {
      "skill": "confirm_reassignment",
      "requester": "orchestrator",
      "context_id": "ctx_asg_0001",
      "label": "일 넘기기",
      "input": {
        "change_id": "${step1.output.change_id}",
        "successor_id": "emp_07"
      },
      "expect": {
        "status": "completed",
        "outcome": "confirmed"
      }
    },
    {
      "skill": "confirm_offboarding",
      "requester": "orchestrator",
      "context_id": "ctx_asg_0001",
      "label": "퇴직 확정 → 보류",
      "input": {
        "change_id": "${step1.output.change_id}"
      },
      "expect": {
        "status": "input-required",
        "output": {
          "status": "held"
        },
        "output_has": [
          "hold_id"
        ]
      },
      "key": "ctx_demo:off"
    },
    {
      "action": "decide_hold",
      "label": "사람이 거절",
      "review_id": "${step3.output.hold_id}",
      "approved": false
    },
    {
      "skill": "confirm_offboarding",
      "requester": "orchestrator",
      "context_id": "ctx_asg_0001",
      "label": "거절 반영(퇴직 취소, 잠금 해제)",
      "input": {
        "change_id": "${step1.output.change_id}"
      },
      "expect": {
        "status": "completed",
        "outcome": "rejected",
        "output": {
          "status": "rejected"
        }
      },
      "key": "ctx_demo:off"
    },
    {
      "skill": "request_assignment_change",
      "requester": "orchestrator",
      "context_id": "ctx_asg_0001",
      "label": "같은 요청으로 다시 열기",
      "input": {
        "change_kind": "offboarding",
        "member_id": "emp_06",
        "area": "support-desk",
        "successor_id": "emp_07"
      },
      "expect": {
        "status": "completed",
        "outcome": "reopened"
      }
    },
    {
      "skill": "confirm_offboarding",
      "requester": "orchestrator",
      "context_id": "ctx_asg_0001",
      "label": "새 보류",
      "input": {
        "change_id": "${step1.output.change_id}"
      },
      "expect": {
        "status": "input-required",
        "output": {
          "status": "held"
        },
        "output_has": [
          "hold_id"
        ]
      },
      "key": "ctx_demo:off"
    },
    {
      "action": "decide_hold",
      "label": "사람이 승인",
      "review_id": "${step7.output.hold_id}",
      "approved": true
    },
    {
      "skill": "confirm_offboarding",
      "requester": "orchestrator",
      "context_id": "ctx_asg_0001",
      "label": "퇴직 적용",
      "input": {
        "change_id": "${step1.output.change_id}"
      },
      "expect": {
        "status": "completed",
        "outcome": "confirmed",
        "output": {
          "status": "confirmed"
        }
      },
      "key": "ctx_demo:off"
    }
  ]
}
