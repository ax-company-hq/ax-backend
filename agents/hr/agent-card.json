{
  "name": "hr",
  "owner": "준하",
  "description": "인사 — 부서가 보낸 사건·결정 기록을 받아 회사 기억에 카드로 남긴다",
  "url": "http://hr:8104/a2a",
  "version": "0.1.0",
  "capabilities": {
    "streaming": true,
    "push_notifications": false
  },
  "skills": [
    {
      "id": "record_case",
      "description": "부서가 보낸 사건·결정 기록(kind, 요약, 결정 이유, 검토한 대안, 근거 참조)을 받아 결정 카드로 정리해 회사 기억에 저장한다. 결정이 없는 기록은 기록만 남기고, 확신이 낮은 카드는 후보로 보류한다. 같은 기록이 두 번 오면 한 번만 처리한다.",
      "input_schema": "contracts/src/ax_contracts/schemas/record.py#RecordCase",
      "output_schema": "contracts/src/ax_contracts/schemas/hr.py#RecordCaseOutput",
      "grade": "A",
      "allowed_requesters": [
        "orchestrator",
        "planning",
        "support",
        "marketing",
        "finance",
        "data",
        "infra"
      ],
      "verifier": null,
      "priority": "required"
    },
    {
      "id": "get_roster",
      "description": "영역별 담당자·역할·교대 일정과, 담당이 없거나 교대 시각에 비는 공백 영역을 조회한다(조회 전용, 개인 인사 정보 없음).",
      "input_schema": "contracts/src/ax_contracts/schemas/hr.py#GetRosterInput",
      "output_schema": "contracts/src/ax_contracts/schemas/hr.py#GetRosterOutput",
      "grade": "read",
      "allowed_requesters": [
        "orchestrator",
        "planning",
        "support",
        "marketing",
        "finance",
        "data",
        "infra",
        "dashboard-api"
      ],
      "verifier": null,
      "priority": "required"
    },
    {
      "id": "start_handover",
      "description": "인계자·영역을 받아 인수인계 초안을 만든다. 진행 중인 일(planning)·결정 카드(회사 기억)·연락처(명부)는 자동으로 채우고, 빈 자리는 인계자에게 묻는 질문으로 돌려준다. 완성도와 빈 자리 수는 코드가 계산한다.",
      "input_schema": "contracts/src/ax_contracts/schemas/hr.py#StartHandoverInput",
      "output_schema": "contracts/src/ax_contracts/schemas/hr.py#StartHandoverOutput",
      "grade": "A",
      "allowed_requesters": ["orchestrator", "dashboard-api"],
      "verifier": null,
      "priority": "required"
    },
    {
      "id": "answer_handover_question",
      "description": "인계자가 빈 자리 질문에 답하면 해당 항목을 채우고 완성도를 다시 계산한다. 같은 답을 두 번 보내도 한 번만 반영한다.",
      "input_schema": "contracts/src/ax_contracts/schemas/hr.py#AnswerHandoverQuestionInput",
      "output_schema": "contracts/src/ax_contracts/schemas/hr.py#AnswerHandoverQuestionOutput",
      "grade": "A",
      "allowed_requesters": ["orchestrator", "dashboard-api"],
      "verifier": null,
      "priority": "required"
    },
    {
      "id": "confirm_handover",
      "description": "인수인계를 확정한다. 완성도가 기준 이상이면 planning이 진행 중 항목 누락을 교차검증한 뒤 확정(B), 기준 미만이면 보류 큐에 올려 사람이 결정한다(C).",
      "input_schema": "contracts/src/ax_contracts/schemas/hr.py#ConfirmHandoverInput",
      "output_schema": "contracts/src/ax_contracts/schemas/hr.py#ConfirmHandoverOutput",
      "grade": "B",
      "allowed_requesters": ["orchestrator", "dashboard-api"],
      "verifier": "planning",
      "priority": "required"
    },
    {
      "id": "start_onboarding",
      "description": "새 담당자의 온보딩 계획을 만든다. 해당 영역의 유효한 결정 카드를 읽을 순서대로 나열하고, 인수인계 확인과 공통 확인 목록을 붙인다. 진행률은 끝낸 단계 수로 계산한다.",
      "input_schema": "contracts/src/ax_contracts/schemas/hr.py#StartOnboardingInput",
      "output_schema": "contracts/src/ax_contracts/schemas/hr.py#StartOnboardingOutput",
      "grade": "A",
      "allowed_requesters": ["orchestrator", "dashboard-api"],
      "verifier": null,
      "priority": "required"
    },
    {
      "id": "request_assignment_change",
      "description": "교대·발령·퇴직·입사 변경을 요청받아 확인 목록, 후임 후보, 권한 변경 목록(전달만, 실행은 각 부서)을 만들고 인수인계(입사는 온보딩)를 함께 시작한다. 같은 사람·영역의 변경이 진행 중이면 잠금으로 막는다.",
      "input_schema": "contracts/src/ax_contracts/schemas/hr.py#RequestAssignmentChangeInput",
      "output_schema": "contracts/src/ax_contracts/schemas/hr.py#RequestAssignmentChangeOutput",
      "grade": "A",
      "allowed_requesters": ["orchestrator", "dashboard-api"],
      "verifier": null,
      "priority": "required"
    },
    {
      "id": "confirm_reassignment",
      "description": "재배치(발령·교대·입사)를 확정한다. 변경 뒤 담당이 비거나 겹치는 영역이 없는지 코드 규칙으로 먼저 확인하고, 통과하면 적용한 뒤 다시 검증하며 문제가 있으면 되돌린다.",
      "input_schema": "contracts/src/ax_contracts/schemas/hr.py#ConfirmReassignmentInput",
      "output_schema": "contracts/src/ax_contracts/schemas/hr.py#ConfirmReassignmentOutput",
      "grade": "B",
      "allowed_requesters": ["orchestrator", "dashboard-api"],
      "verifier": "safety_rule",
      "priority": "required"
    },
    {
      "id": "confirm_offboarding",
      "description": "퇴직을 확정한다. C 등급이라 보류 큐에서 사람이 승인해야 하며, 승인 뒤 같은 요청을 다시 보내면 적용한다. 퇴직으로 담당이 비는 영역이 생기면 적용하지 않는다.",
      "input_schema": "contracts/src/ax_contracts/schemas/hr.py#ConfirmOffboardingInput",
      "output_schema": "contracts/src/ax_contracts/schemas/hr.py#ConfirmOffboardingOutput",
      "grade": "C",
      "allowed_requesters": ["orchestrator", "dashboard-api"],
      "verifier": null,
      "priority": "required"
    }
  ]
}
