# agents/finance 전용 환경변수 예시. 복사해서 agents/finance/.env로 쓴다 (커밋 금지).
# 공통 변수(TENANT_ID, REDIS_URL, LLM_* 등)는 루트 .env에 둔다.

# 1이면 LLM·외부 호출 대신 가짜 응답 (CI는 항상 1)
FINANCE_MOCK=

# 공통 LLM_MODEL 대신 이 서비스만 다른 모델을 쓸 때
# FINANCE_LLM_MODEL=

# 이 서비스의 에이전트 토큰 (requester는 토큰에서 꺼낸다)
FINANCE_TOKEN=

# 대시보드 출처 (쉼표 구분, 조회 GET만 허용). 기본 http://localhost:3001,http://127.0.0.1:3001
# FINANCE_CORS_ORIGINS=

# 재무 AI 테스트 자동 실행 주기(초). 서버가 켜지고 5초 뒤 한 번, 그다음 이 주기마다. 기본 600(10분), 0이면 끔
# FINANCE_SELF_TEST_SECONDS=600

# 매일 결산 자동 실행 주기(초). 전날 하루 결산을 미리 계산해 /api/finance/closing/last에 남긴다.
# 기본 86400(하루), 0이면 끔. 확정은 사람이 누른다
# FINANCE_DAILY_CLOSING_SECONDS=86400
