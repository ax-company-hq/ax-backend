# agents/infra-dejafix 전용 환경변수 예시. 복사해서 agents/infra-dejafix/.env로 쓴다 (커밋 금지).
# 공통 변수(TENANT_ID, REDIS_URL, LLM_* 등)는 루트 .env에 둔다.

# 1이면 LLM·외부 호출 대신 가짜 응답 (CI는 항상 1)
INFRA_MOCK=

# 공통 LLM_MODEL 대신 이 서비스만 다른 모델을 쓸 때
# INFRA_LLM_MODEL=

# 이 서비스의 에이전트 토큰 (requester는 토큰에서 꺼낸다)
INFRA_TOKEN=

# 배포 이력 파일 (비우면 패키지 안 data/deployments.json)
# INFRA_DEPLOYMENTS_FILE=

# 진단 구간(분), 기본 60
# INFRA_DIAGNOSE_LOOKBACK_MIN=60

# 복구 확인 횟수·간격(초), 기본 5회·30초
# INFRA_RECOVERY_ATTEMPTS=5
# INFRA_RECOVERY_INTERVAL_S=30

# agent-card.json 경로 (비우면 자동으로 찾음)
# INFRA_AGENT_CARD=

# shop-api·data 주소 (비우면 목)
# AX_SHOP_API_URL=
# AX_DATA_URL=
