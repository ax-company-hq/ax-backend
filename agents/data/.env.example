# agents/data 전용 환경변수 예시. 복사해서 agents/data/.env로 쓴다 (커밋 금지).
# 공통 변수(TENANT_ID, REDIS_URL, LLM_* 등)는 루트 .env에 둔다.

# 1이면 LLM·외부 호출 대신 가짜 응답 (CI는 항상 1)
DATA_MOCK=

# 목 모드 데모 장애 길이(분). impact_analysis 구간 시작(anchor)부터 이 시간 동안 결제 실패율이 오른다.
# 데모에서는 이 시간 안에 롤백한다. 기본 6, 최소 5
DATA_DEMO_INCIDENT_MINUTES=6

# 목 모드 데모 장애 시각(anchor)을 마지막 anchor 요청 뒤 이 시간(분)이 지나면 비운다(안전장치). 기본 60
DATA_DEMO_RESET_MINUTES=60

# 공통 LLM_MODEL 대신 이 서비스만 다른 모델을 쓸 때
# DATA_LLM_MODEL=

# 이 서비스의 에이전트 토큰 (requester는 토큰에서 꺼낸다)
DATA_TOKEN=
