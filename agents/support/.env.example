# agents/support 전용 환경변수 예시. 복사해서 agents/support/.env로 쓴다 (커밋 금지).
# 공통 변수(TENANT_ID, REDIS_URL, LLM_* 등)는 루트 .env에 둔다.

# 1이면 LLM·외부 호출 대신 가짜 응답 (CI는 항상 1)
SUPPORT_MOCK=

# 공통 LLM_MODEL 대신 이 서비스만 다른 모델을 쓸 때
# SUPPORT_LLM_MODEL=

# 클레임 판정에 쓸 주문의 출처: seed | shop-api. 비우면 목 모드는 seed, 아니면 shop-api
# (shop-api 주소는 공통 AX_SHOP_API_URL, 기본 http://shop-api:8010)
SUPPORT_ORDER_SOURCE=

# DejaFix로 보내는 고객 개인정보를 암호화하는 키(AES-256, base64 32바이트). 레포에 두지 않는다.
# 만들기: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# 이 값은 DejaFix 담당과 따로 안전하게 나눈다. 비어 있으면 고객 필드가 든 요청은 DejaFix로 보내지 않는다.
SUPPORT_DEJAFIX_KEY=
# 키를 바꿀 때 구분하는 이름 (암호문에 담긴다)
SUPPORT_DEJAFIX_KEY_ID=k1

# 이 서비스의 에이전트 토큰 (requester는 토큰에서 꺼낸다)
SUPPORT_TOKEN=

# 문의·클레임·보상 번호를 저장하는 PostgreSQL 접속 주소. 비우면 프로세스 메모리에만 저장한다
# (재시작하면 사라진다). compose에서는 support-db 서비스 주소로 덮어쓴다.
SUPPORT_PG_DSN=
# compose의 support-db 비밀번호 (로컬 개발용 기본값은 change-me)
SUPPORT_DB_PASSWORD=
