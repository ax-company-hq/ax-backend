# dashboard-api 전용 환경변수 예시. 복사해서 dashboard-api/.env로 쓴다 (커밋 금지).
# 공통 변수(TENANT_ID, REDIS_URL, LLM_* 등)는 루트 .env에 둔다.

# 1이면 LLM·외부 호출 대신 가짜 응답 (CI는 항상 1)
# 비우면 문의 API는 support 에이전트(A2A)를 부른다 (주소는 AX_SUPPORT_URL, 기본 http://support:8102)
DASHBOARD_MOCK=

# 이 서비스의 에이전트 토큰 (requester는 토큰에서 꺼낸다)
DASHBOARD_API_TOKEN=

# 브라우저에서 부를 수 있는 출처 (쉼표 구분). 비우면 localhost:3000,3001
DASHBOARD_CORS_ORIGINS=

# 쓰기(POST 등) API의 사람 토큰 "이름:토큰,이름:토큰". 비우면 SAFETY_HUMAN_TOKENS를 읽는다.
# 둘 다 비고 목 모드도 아니면 쓰기를 모두 거부한다 (fail-closed). 목 모드는 human:<이름>도 받는다
DASHBOARD_HUMAN_TOKENS=
