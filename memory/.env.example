# memory 전용 환경변수 예시. 복사해서 memory/.env로 쓴다 (커밋 금지).
# 공통 변수(TENANT_ID, REDIS_URL, LLM_* 등)는 루트 .env에 둔다.

# 1이면 LLM·외부 호출 대신 가짜 응답 (CI는 항상 1)
MEMORY_MOCK=

# 이 서비스의 에이전트 토큰 (requester는 토큰에서 꺼낸다)
MEMORY_TOKEN=

# postgres(pgvector) 접속. compose 안에서는 compose.yml이 이 값을 덮어쓴다 (아래는 가짜 값)
MEMORY_PG_DSN=postgresql://memory:change-me@localhost:5433/memory
# postgres 비밀번호 (compose가 memory-db와 memory에 같이 넣는다)
MEMORY_DB_PASSWORD=change-me
# 임베딩 벡터 차원. 모델을 바꾸면 cards 테이블을 다시 만들어야 한다
MEMORY_EMBED_DIM=768
# 임베딩 모델 이름 (LLM 래퍼에 넘긴다. 코드에 하드코딩하지 않는다)
MEMORY_EMBED_MODEL=
