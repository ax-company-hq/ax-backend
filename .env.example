# 루트 .env.example — 공통 변수만 둔다 (사람 승인 경로).
# 복사해서 .env로 쓰고, .env는 절대 커밋하지 않는다.
# 부서별 변수(<접두사>_MOCK 등)는 각 패키지 폴더의 .env.example에 있다.

# 테넌트 id. 모든 테이블·요청·이벤트·카드에 필수
TENANT_ID=shop-demo
# 이벤트 버스 (Redis Streams). compose 안에서는 redis://redis:6379/0
REDIS_URL=
# 공용 Postgres. compose 안에서는 postgresql://ax:ax@postgres:5432/ax
DATABASE_URL=
# LLM 설정. agent-template의 OpenAI 호환 래퍼가 읽는다. 코드에 모델을 하드코딩하지 않는다
LLM_MODEL=
LLM_BASE_URL=
# LLM 키는 각자 따로 쓴다
LLM_API_KEY=

# 게이트웨이(nginx) 공개 포트. 외부에 열리는 포트는 이것 하나뿐이다 (/ 쇼핑몰, /admin/ 관리자, /admin/planning/ 기획개발).
# 비우면 8080. Zabbix가 80을 쓸 수 있어 8080을 유지한다
AX_GATEWAY_PORT=8080
