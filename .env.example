# 루트 .env.example — 공통 변수만 둔다 (사람 승인 경로).
# 복사해서 .env로 쓰고, .env는 절대 커밋하지 않는다. 부서 전용 변수 예시는 <폴더>/.env.example에 둔다.

# ── 공통 ──────────────────────────────────────────────
# 테넌트 id. 모든 테이블·요청·이벤트·카드에 필수
TENANT_ID=shop-demo
# 이벤트 버스 (Redis Streams). compose 안에서는 redis://redis:6379/0
REDIS_URL=
# 공용 Postgres. compose 안에서는 postgresql://ax:ax@postgres:5432/ax
DATABASE_URL=
# LLM 설정. agent-template의 OpenAI 호환 래퍼가 읽는다. 코드에 모델을 하드코딩하지 않는다
LLM_MODEL=
LLM_BASE_URL=
# LLM 키는 각자 따로 쓴다
LLM_API_KEY=

# ── 부서별 LLM 덮어쓰기 (필요할 때만 주석 해제) ─────────────
# DATA_LLM_MODEL=
# SUPPORT_LLM_MODEL=
# MARKETING_LLM_MODEL=
# PLANNING_LLM_MODEL=
# FINANCE_LLM_MODEL=
# HR_LLM_MODEL=
# INFRA_LLM_MODEL=
# ORCHESTRATOR_LLM_MODEL=

# ── 목 모드 (1이면 LLM·외부 호출 대신 가짜 응답. CI는 항상 1) ──
ORCHESTRATOR_MOCK=
SAFETY_MOCK=
MEMORY_MOCK=
SHOP_MOCK=
DASHBOARD_MOCK=
PLANNING_MOCK=
SUPPORT_MOCK=
MARKETING_MOCK=
HR_MOCK=
FINANCE_MOCK=
DATA_MOCK=
INFRA_MOCK=

# ── 에이전트 토큰 (서비스마다 하나. requester는 토큰에서 꺼낸다) ──
ORCHESTRATOR_TOKEN=
SAFETY_TOKEN=
MEMORY_TOKEN=
SHOP_TOKEN=
DASHBOARD_TOKEN=
PLANNING_TOKEN=
SUPPORT_TOKEN=
MARKETING_TOKEN=
HR_TOKEN=
FINANCE_TOKEN=
DATA_TOKEN=
INFRA_TOKEN=
