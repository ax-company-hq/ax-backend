# safety 전용 환경변수 예시. 복사해서 safety/.env로 쓴다 (커밋 금지).
# 공통 변수(TENANT_ID, REDIS_URL, LLM_* 등)는 루트 .env에 둔다.

# 1이면 LLM·외부 호출 대신 가짜 응답 (CI는 항상 1)
SAFETY_MOCK=

# 이 서비스의 에이전트 토큰 (requester는 토큰에서 꺼낸다)
SAFETY_TOKEN=

# C 보류 결정 API에 쓰는 사람 토큰 목록 "이름:토큰,이름:토큰" (에이전트 토큰은 항상 거부)
SAFETY_HUMAN_TOKENS=

# 레지스트리·기준표를 다른 파일로 바꿀 때 (기본은 패키지 안 rules/*.toml)
# SAFETY_REGISTRY_PATH=
# SAFETY_THRESHOLDS_PATH=

# AI 1차 판단 마스터 스위치. 1일 때만 thresholds.toml [auto_review]가 돈다 (기본 꺼짐).
# 기준 문서(SAF-05)를 바꾸는 docs PR이 머지되기 전에는 켜지 않는다
# SAFETY_AUTO_REVIEW=

# 기준 바꾸기 마스터 스위치. 1일 때만 POST /api/safety/threshold-changes(요청·결정)와 저장 값 복원이 돈다
# (기본 꺼짐: POST는 403 FEATURE_OFF, GET 기록은 빈 목록). 기준 문서(SAF-02)를 바꾸는 docs PR이
# 머지되기 전에는 켜지 않는다
# SAFETY_THRESHOLD_CHANGES=

# 사람이 적용한 기준 바꾸기를 저장하는 파일 (재시작하면 복원). 기본 data/safety/threshold_overrides.json
# SAFETY_THRESHOLD_OVERRIDES_PATH=

# 대시보드 출처 (쉼표 구분). 기본 http://localhost:3001,http://127.0.0.1:3001
# SAFETY_CORS_ORIGINS=
