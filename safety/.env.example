# safety 전용 환경변수 예시. 복사해서 safety/.env로 쓴다 (커밋 금지).
# 공통 변수(TENANT_ID, REDIS_URL, LLM_* 등)는 루트 .env에 둔다.

# 1이면 LLM·외부 호출 대신 가짜 응답 (CI는 항상 1)
SAFETY_MOCK=

# 이 서비스의 에이전트 토큰 (requester는 토큰에서 꺼낸다)
SAFETY_TOKEN=

# C 보류 결정 API에 쓰는 사람 토큰 목록 "이름:토큰,이름:토큰" (에이전트 토큰은 항상 거부)
SAFETY_HUMAN_TOKENS=

# 레지스트리·기준표를 다른 파일로 바꿀 때 (기본은 패키지 안 rules/*.toml)
# SAFETY_REGISTRY_PATH=
# SAFETY_THRESHOLDS_PATH=
